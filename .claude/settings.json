{
  "extraKnownMarketplaces": {
    "headroom-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/headroomlabs-ai/headroom"
      }
    }
  },
  "enabledPlugins": {
    "headroom@headroom-marketplace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ]
  }
}