NODE_ENV=production
APP_ENV=staging
HOST=127.0.0.1
PORT=3100
DB_PATH=/var/lib/disbit-staging/disbit.db
PROOFS_DIR=/var/lib/disbit-staging/proofs
PUBLIC_URL=https://staging.disbit.ru
PAYMENTS_PROVIDER=disabled
PAYMENTS_CURRENCY=RUB
# Set to the real deployed Git SHA, not the example below.
RELEASE_SHA=0000000
# Generate on the server; never commit the filled environment file.
ADMIN_KEY=
MAIL_PROVIDER=resend
MAIL_FROM=
RESEND_API_KEY=
