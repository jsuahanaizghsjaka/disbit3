NODE_ENV=production
APP_ENV=production
HOST=127.0.0.1
PORT=3000
DB_PATH=/var/lib/disbit-production/disbit.db
PROOFS_DIR=/var/lib/disbit-production/proofs
PUBLIC_URL=https://disbit.ru
PAYMENTS_PROVIDER=disabled
PAYMENTS_CURRENCY=RUB
RELEASE_SHA=0000000
ADMIN_KEY=
MAIL_PROVIDER=resend
MAIL_FROM=
RESEND_API_KEY=
# For RuSender instead, set MAIL_PROVIDER=rusender, MAIL_FROM to a verified
# bare email address, and provide these in the protected server environment.
RUSENDER_API_TOKEN=
RUSENDER_KEY_ID=
