# Common switch; production also requires the separate opt-in below.
GOOGLE_OAUTH_ENABLED=0
GOOGLE_OAUTH_PRODUCTION_ENABLED=0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Existing staging PUBLIC_URL must exactly match the client redirect origin.
# PUBLIC_URL=https://staging.disbit.ru
# Callback: /api/auth/oauth/google/callback
